        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "api-key",
              "value": "={{ $credentials.qdrantApiKey }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "filter",
              "value": "={{ { \"must\": [{ \"key\": \"metadata.filename\", \"match\": { \"value\": $json.basename } }] } } }}"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "check-existing-001",
      "name": "Check Existing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1904,
        496
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "qdrant-auth",
          "name": "Qdrant API Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Check if file exists in Qdrant via HTTP API\nconst response = $input.first().json;\nconst currentFile = $thisItem.json;\n\n// Qdrant scroll returns { result: { points: [...] } }\nconst points = response?.result?.points || [];\n\nif (points.length > 0) {\n  const existingDoc = points[0];\n  const pointId = existingDoc.id;\n  \n  return {\n    json: {\n      action: 'delete_and_insert',\n      filename: currentFile.basename,\n      pointId: pointId,\n      basename: currentFile.basename\n    }\n  };\n} else {\n  return {\n    json: {\n      action: 'insert_only',\n      filename: currentFile.basename,\n      basename: currentFile.basename\n    }\n  };\n}"
      },
