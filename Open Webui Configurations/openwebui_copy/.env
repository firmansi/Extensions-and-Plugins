# Open WebUI Environment Variables

# Application Settings
PUBLIC_WEBUI_NAME=Dialog Matasigma
WEBUI_SECRET_KEY=m!m@n070455

# Database (PostgreSQL)
DB_TYPE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=webui
DB_USER=webui
DB_PASSWORD=fZ6f7YpjfntjAqN7rduL9KSyx9Mq1Y

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=IL5yHFbPePf2oX52hS6hiOlQi9ZCll

# Vector Store: ChromaDB (for RAG)
VECTOR_STORE=chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PATH=/app/data/chroma

# Disable Ollama and Web Search
OLLAMA_API_BASE_URL=
ENABLE_WEB_SEARCH=false

# Feature Flags
ENABLE_TEMPORARY_CHAT=true
ENABLE_MODEL_SELECTOR=true
ENABLE_FILE_UPLOAD=true
ENABLE_SIGNUP=true
USER_ROLE=user

# MCP Server Configuration — Custom MCP Server (you will deploy separately)
# Open WebUI connects to this URL for tools/resources
MCP_SERVER_CUSTOM_URL=http://mcp-server:8000/v1

# Important: This is the internal Docker network address.
# When exposed externally, reverse proxy must route dialogv.matasigma.com:4400 to openwebui:8080
